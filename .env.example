# ─── API Configuration ───────────────────────────────────────────────────────
# Base URL for the backend API. Leave empty to use /api/v1 relative paths.
VITE_API_BASE_URL=

# ─── Mock Mode ────────────────────────────────────────────────────────────────
# Set to "false" to use the real backend API instead of mock data.
# Default is "true" (mock mode enabled).
VITE_USE_MOCK=true
